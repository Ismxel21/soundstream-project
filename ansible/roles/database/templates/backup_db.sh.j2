#!/usr/bin/env bash
set -euo pipefail

BACKUP_DIR="/var/backups/soundstream"
TIMESTAMP=$(date +"%Y-%m-%d_%H%M%S")
BACKUP_FILE="${BACKUP_DIR}/soundstream_db_${TIMESTAMP}.sql.gz"

mkdir -p "${BACKUP_DIR}"
podman exec soundstream-db pg_dump -U {{ soundstream_db_user }} -d {{ soundstream_db_name }} | gzip > "${BACKUP_FILE}"
find "${BACKUP_DIR}" -name "soundstream_db_*.sql.gz" -type f -mtime +7 -delete

echo "[OK] Respaldo generado exitosamente: ${BACKUP_FILE}"
